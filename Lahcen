
name: Build Lahcen Marker APK

on:
  workflow_dispatch:
  push:
    branches:
      - main

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: stable

      - name: Extract project
        run: |
          mkdir -p app
          unzip -o Lahcen_Marker_Android_Starter.zip -d app

      - name: Prepare Android project
        run: |
          PUBSPEC=$(find app -name pubspec.yaml -print -quit)
          if [ -z "$PUBSPEC" ]; then
            echo "Flutter project not found in ZIP"
            exit 1
          fi
          PROJECT_DIR=$(dirname "$PUBSPEC")
          cd "$PROJECT_DIR"
          if [ ! -f android/app/build.gradle ] && [ ! -f android/app/build.gradle.kts ]; then
            flutter create --platforms=android .
          fi
          flutter pub get
          flutter build apk --release
          mkdir -p "$GITHUB_WORKSPACE/output"
          cp build/app/outputs/flutter-apk/app-release.apk "$GITHUB_WORKSPACE/output/"

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Lahcen-Marker-APK
          path: output/app-release.apk
